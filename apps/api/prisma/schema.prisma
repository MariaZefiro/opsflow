generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  AGENT
  USER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum ServiceType {
  HTTP
  HTTPS
  TCP
  ICMP
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentCreatedBy {
  MANUAL
  MONITORING
}

enum AlertChannel {
  EMAIL
  WEBHOOK
  IN_APP
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

model Company {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  plan          Plan           @default(FREE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  users         User[]
  tickets       Ticket[]
  services      Service[]
  incidents     Incident[]
  slaPolicies   SLAPolicy[]
  alerts        Alert[]
  webhooks      Webhook[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([deletedAt])
}

model User {
  id                  String               @id @default(cuid())
  companyId           String
  name                String
  email               String
  passwordHash        String
  role                Role                 @default(USER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  company             Company              @relation(fields: [companyId], references: [id])
  requestedTickets    Ticket[]             @relation("TicketRequester")
  assignedTickets     Ticket[]             @relation("TicketAssignee")
  comments            TicketComment[]
  history             TicketHistory[]
  incidents           Incident[]           @relation("IncidentAssignee")
  createdIncidents    Incident[]           @relation("IncidentCreator")
  activityLogs        ActivityLog[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, deletedAt])
}

model Ticket {
  id          String          @id @default(cuid())
  companyId   String
  title       String
  description String
  category    String
  priority    TicketPriority  @default(MEDIUM)
  status      TicketStatus    @default(OPEN)
  requesterId String
  assigneeId  String?
  slaDueAt    DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  company     Company         @relation(fields: [companyId], references: [id])
  requester   User            @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments    TicketComment[]
  history     TicketHistory[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, deletedAt])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

model Service {
  id             String         @id @default(cuid())
  companyId      String
  name           String
  url            String
  type           ServiceType
  checkInterval  Int            @default(60)
  timeout        Int            @default(10)
  expectedStatus Int            @default(200)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  company        Company        @relation(fields: [companyId], references: [id])
  checks         ServiceCheck[]
  incidents      Incident[]

  @@index([companyId])
  @@index([companyId, deletedAt])
}

model ServiceCheck {
  id             String   @id @default(cuid())
  serviceId      String
  httpStatus     Int?
  responseTimeMs Int?
  success        Boolean
  errorMessage   String?
  checkedAt      DateTime @default(now())
  service        Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId, checkedAt])
}

model Incident {
  id              String            @id @default(cuid())
  companyId       String
  serviceId       String?
  title           String
  description     String
  severity        IncidentSeverity
  status          IncidentStatus    @default(INVESTIGATING)
  assigneeId      String?
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  createdBy       IncidentCreatedBy
  createdByUserId String
  company         Company           @relation(fields: [companyId], references: [id])
  service         Service?          @relation(fields: [serviceId], references: [id])
  assignee        User?             @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  creator         User              @relation("IncidentCreator", fields: [createdByUserId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
}

model SLAPolicy {
  id              String         @id @default(cuid())
  companyId       String
  priority        TicketPriority
  resolutionHours Int
  company         Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, priority])
  @@index([companyId])
}

model Alert {
  id        String       @id @default(cuid())
  companyId String
  type      String
  payload   Json
  channel   AlertChannel
  status    AlertStatus  @default(PENDING)
  createdAt DateTime     @default(now())
  company   Company      @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
}

model Webhook {
  id        String   @id @default(cuid())
  companyId String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId, isRead])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
}
